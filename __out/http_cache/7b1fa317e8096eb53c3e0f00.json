{"url": "https://klpga.co.kr/load/leaderboard/roundLeaderboard", "params": {"data": {"gameCode": "2026060002", "round": "4"}}, "body_text": "\r\n\r\n\r\n\r\n\r\n\r\n\r\n<script type=\"text/javascript\">\r\nvar map3dResourceYN = \"Y\";\r\n\r\n$(document).ready(function(){\r\n\t\r\n\t\r\n\t\r\n});\r\n\r\n\r\n$(document).off(\"click\", \"[id=btnDetail]\").on(\"click\", \"[id=btnDetail]\", function(event){\r\n\t\r\n\tif(!$(this).parents(\"details\").find(\".divDetail\").html() == \"\"){\r\n\t\t$(\".divDetail\").html(\"\");\r\n\t\tsetRefreshTimeout(\"4\");\r\n\t\treturn;\r\n\t}\r\n\t\r\n\t// 선수상세보기 활성화시 리프레시 안함\r\n\tclearTimeout(refreshTimer);\r\n\t\r\n\t$(\"details\").removeAttr(\"open\");\r\n\t$(\".divDetail\").html(\"\");\r\n\t\r\n\tvar params = new Object();\r\n\tparams.playerCode = $(this).attr(\"_playerCode\");\r\n\tparams.gameCode = $(this).attr(\"_gameCode\");\r\n\tparams.playerName = $(this).attr(\"_playerName\");\r\n\tparams.playerEngName = $(this).attr(\"_playerEngName\");\r\n\tparams.groupNo = $(this).attr(\"_groupNo\");\r\n\tparams.playerImg = $(this).attr(\"_playerImg\");\r\n\tparams.round = $(this).attr(\"_round\");\r\n\tparams.hole = $(this).attr(\"_hole\");\r\n\tparams.level = $(this).attr(\"_level\");\r\n\tparams.ballModelText = $(this).attr(\"_ballModelText\");\r\n\t\r\n\t$(this).parents(\"details\").find(\".divDetail\").load(\"/load/leaderboard/playerDetail\", params, function(responseText, textStatus, XMLHttpRequest){\r\n\t\tif (XMLHttpRequest.status != 200){\r\n\t\t\t//location.reload();\r\n\t\t\talert(\"error\");\r\n\t\t}\r\n\t\tif(scrollValue+20 > $(this).offset().top){\r\n\t\t\twindow.scrollTo({top:$(this).offset().top-100, left:0});\t\r\n\t\t}\r\n\t});\r\n\t\r\n});\r\n\r\n$(document).off(\"click\", \"[id=btnNameExtra]\").on(\"click\", \"[id=btnNameExtra]\", function(event){\r\n\t\r\n\t$(\"[id=btnNameExtra]\").find(\"button\").removeClass(\"active\");\r\n\t$(\"[id=btnNameExtra][_index=\"+$(this).attr(\"_index\")+\"]\").find(\"button\").addClass(\"active\");\r\n\t\r\n\t$(\"[id=trShotStateExtra]\").css(\"display\",\"none\");\r\n\t$(\"[id=trShotStateExtra][data-index=\"+$(this).attr(\"_index\")+\"]\").css(\"display\",\"\");\r\n\t\r\n});\r\n\r\n// 연장전 샷비디오\r\n$(document).off(\"click\", \"[id=btnExtraShotVideo]\").on(\"click\", \"[id=btnExtraShotVideo]\", function(event){\r\n\tvar params = new Object();\r\n\tparams.playerCode = $(this).data(\"playerCode\");\r\n\tparams.gameCode = $(this).data(\"gameCode\");\r\n\tparams.round = $(this).data(\"round\");\r\n\tparams.shot = $(this).data(\"shot\");\r\n\tparams.refererExtraYN = \"Y\";\r\n\t\r\n\t$(\"#mediaModal\").find(\"div\").load(\"/load/shotVideo\", params, function(responseText, textStatus, XMLHttpRequest){\r\n\t\tif (XMLHttpRequest.status != 200){\r\n\t\t\t//location.reload();\r\n\t\t\talert(\"error\");\r\n\t\t}\r\n\t});\r\n});\r\n\r\n\r\nfunction getExtraShotTracker(extraNo, hole){\r\n\t\r\n\t// 2024년 이후 연장전 샷트래커 진행\r\n\tif(\"20260626\" < \"20240101\"){\r\n\t\treturn;\t\r\n\t}\r\n\t\r\n\t$.ajax({\r\n\t\t  \"url\"   : \"/ajax/leaderboard/getExtraShotTracker\"\r\n\t    , \"type\"  : \"POST\"\r\n\t    , \"async\" : false\r\n\t    , \"data\"  : {\r\n\t    \tgameCode : \"2026060002\"\r\n\t    \t, ingRound : \"3\"\r\n\t    \t, extraNo : extraNo\r\n\t    \t, hole : hole\r\n  \t\t}\r\n\t\t, success: function(res,ststus,xhr) {\r\n\t\t\t\r\n\t\t\tvar evalData \t\t= eval(res);\r\n\t\t\tvar baseHoleInfo\t= evalData.baseHoleInfo;\r\n\t\t\tvar extraPlayerList\t= evalData.extraPlayerList;\r\n\t\t\tvar extraShotTrackerList = evalData.extraShotTrackerList;\r\n\t\t\t\r\n\t\t\tvar holeInfo\t\t= evalData.holeInfo;\r\n\t\t\t$(\"#holeInfo_extra_no\").html(extraNo);\r\n\t\t\t$(\"#holeInfo_extra_holeNo\").html(holeInfo.hole);\r\n\t\t\t$(\"#holeInfo_extra_par\").html(holeInfo.stdScore);\r\n\t\t\tif(\"1\" == '1'){\r\n\t\t\t\t$(\"#holeInfo_extra_yds\").html(holeInfo.yds);\r\n\t\t\t\t$(\"#holeInfo_extra_meter\").html(holeInfo.meter);\r\n\t\t\t}\r\n\t\t\tif(holeInfo.avgScore != 0){\r\n\t\t\t\t$(\"#holeInfo_extra_difficult\").html((holeInfo.count>1?\"T\":\"\")+holeInfo.rank);\r\n\t\t\t\t$(\"#holeInfo_extra_avgScore\").html(holeInfo.avgScore);\t\r\n\t\t\t} else {\r\n\t\t\t\t$(\"#holeInfo_extra_difficult\").html(\"-\");\r\n\t\t\t\t$(\"#holeInfo_extra_avgScore\").html(\"-\");\r\n\t\t\t}\r\n\t\t\t\r\n\t\t\tvar hole_html = \"\";\r\n\t\t\tvar green_html = \"\";\r\n\t\t\tvar state_html =\"\";\r\n\t\t\t\r\n\t\t\tvar bi_sy = 0;\r\n\t\t\tvar bi_sx = 0;\r\n\t\t\tvar bi_gpy = 0;\r\n\t\t\tvar bi_gpx = 0;\r\n\t\t\tvar bi_gx = 0;\r\n\t\t\tvar bi_gy = 0;\r\n\t\t\t\r\n\t\t\tif(baseHoleInfo != null){\r\n\t\t\t\tbi_sy = baseHoleInfo.bi_sy == null?0:baseHoleInfo.bi_sy;\r\n\t\t\t\tbi_sx = baseHoleInfo.bi_sx == null?0:baseHoleInfo.bi_sx;\r\n\t\t\t\tbi_gpy = baseHoleInfo.bi_gpy == null?0:baseHoleInfo.bi_gpy;\r\n\t\t\t\tbi_gpx = baseHoleInfo.bi_gpx == null?0:baseHoleInfo.bi_gpx;\r\n\t\t\t\tbi_gx = baseHoleInfo.bi_gx == null?0:baseHoleInfo.bi_gx;\r\n\t\t\t\tbi_gy = baseHoleInfo.bi_gy == null?0:baseHoleInfo.bi_gy;\r\n\t\t\t}\r\n\t\t\t\r\n\t\t\thole_html += \"<svg viewBox='0 0 708 471' preserveAspectRatio='none' xmlns='http://www.w3.org/2000/svg' style='overflow:hidden'>\"\r\n\t\t\tgreen_html += \"<svg viewBox='0 0 708 471' preserveAspectRatio='none' xmlns='http://www.w3.org/2000/svg' style='overflow:hidden'>\"\r\n\t\t\t\r\n\t\t\tfor(var i=0; i<extraPlayerList.length; i++){\r\n\t\t\t\t\r\n\t\t\t\tvar shotTrackerList = extraShotTrackerList[i];\r\n\t\t\t\t\r\n\t\t\t\thole_html +=  \"<g class='player\"+(i+1)+\"'>\";\r\n\t\t\t\tgreen_html += \"<g class='player\"+(i+1)+\"'>\";\r\n\r\n\t\t\t\t\r\n\t\t\t\tfor(var j = 0; j < shotTrackerList.length; j++){\r\n\t\t\t\t\t\r\n\t\t\t\t\tvar v = shotTrackerList[j];\r\n\t\t\t\t\tvar x = (390-(v.pp_y*2))*1.815;\r\n\t\t\t\t\tvar y = (v.pp_x*2)*1.815;\r\n\t\t\t\t\tvar x_g = (390-(v.pp_greeny*2))*1.815;\r\n\t\t\t\t\tvar y_g = (v.pp_greenx*2)*1.815;\r\n\t\t\t\t\t\r\n\t\t\t\t\tif(j==0){\r\n\t\t\t\t\t\t// 전체\r\n\t\t\t\t\t\thole_html += \"<circle cx='\"+(390-bi_sy)*1.815+\"' cy='\"+bi_sx*1.815+\"' r='4.611'></circle>\";\r\n\t\t\t\t\t\thole_html += \"<path d='M\"+ (390-bi_sy)*1.815 +\" \"+ bi_sx*1.815 +\" L\"+ x +\" \"+ y +\"' h></path>\";\r\n\t\t\t\t\t\thole_html += \"<circle cx='\"+x+\"' cy='\"+y+\"' r='4.611'></circle>\";\r\n\t\t\t\t\t\t// 그린\r\n\t\t\t\t\t\tgreen_html += \"<path d='M\"+ (390-bi_gpy)*1.815 +\" \"+ bi_gpx*1.815 +\" L\"+ x_g +\" \"+ y_g +\"' g></path>\";\r\n\t\t\t\t\t\tgreen_html += \"<circle cx='\"+x_g+\"' cy='\"+y_g+\"' r='4.611'></circle>\";\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t} else {\r\n\t\t\t\t\t\t// 전체\r\n\t\t\t\t\t\tvar pre_x = (390-(shotTrackerList[j-1].pp_y*2))*1.815;\r\n\t\t\t\t\t\tvar pre_y = (shotTrackerList[j-1].pp_x*2)*1.815;\r\n\t\t\t\t\t\thole_html += \"<path d='M\"+ pre_x +\" \"+ pre_y +\" L\"+ x +\" \"+ y +\"' h></path>\";\r\n\t\t\t\t\t\thole_html += \"<circle cx='\"+x+\"' cy='\"+y+\"' r='4.611'></circle>\";\r\n\t\t\t\t\t\t// 그린\r\n\t\t\t\t\t\tvar pre_x_g = (390-(shotTrackerList[j-1].pp_greeny*2))*1.815;\r\n\t\t\t\t\t\tvar pre_y_g = (shotTrackerList[j-1].pp_greenx*2)*1.815;\r\n\t\t\t\t\t\tgreen_html += \"<path d='M\"+ pre_x_g +\" \"+ pre_y_g +\" L\"+ x_g +\" \"+ y_g +\"' g></path>\";\r\n\t\t\t\t\t\tgreen_html += \"<circle cx='\"+x_g+\"' cy='\"+y_g+\"' r='4.611'></circle>\";\r\n\t\t\t\t\t}\r\n\t\t\t\t\t\r\n\t\t\t\t\t// 샷정보\r\n\t\t\t\t\tstate_html += \"<tr id='trShotStateExtra' data-index='\"+(i+1)+\"' style='\"+(i==0 ? '':'display:none;')+\"'>\";\r\n\t\t\t\t\tstate_html += \t\"<td>\"+v.shot+\"</td>\";\r\n\t\t\t\t\tstate_html += \t\"<td class='td-video'>\";\r\n\t\t\t\t\tif(v.shotVideoYN == \"Y\") {\r\n\t\t\t\t\t\tstate_html += \"<button class='btn btn-video p-0' id='btnExtraShotVideo' data-bs-toggle='modal' data-bs-target='#mediaModal'\"\r\n\t\t\t\t\t\t\t+\" data-player-code='\"+v.playerCode+\"' data-game-code='\"+v.gameCode+\"' data-round='\"+v.round+\"' data-hole='\"+v.hole+\"' data-shot='\"+v.shot+\"'>\";\r\n// \t\t\t\t\t\tstate_html +=\t\"<img src='/resources/web/images/btn-videoarrow.svg'></button>\";\r\n\t\t\t\t\t}\r\n\t\t\t\t\tstate_html += \t\"</td>\";\r\n\t\t\t\t\tstate_html += \t\"<td>\"+v.pp_distanceLen+\"</td>\";\r\n\t\t\t\t\tswitch(v.pp_state){\r\n\t\t\t\t\t\tcase \"1\" : state_html += \t\"<td>페어웨이</td>\"; break;\r\n\t\t\t\t\t\tcase \"2\" : state_html += \t\"<td>러프</td>\"; break;\r\n\t\t\t\t\t\tcase \"3\" : state_html += \t\"<td>그린</td>\"; break;\r\n\t\t\t\t\t\tcase \"4\" : state_html += \t\"<td>OB</td>\"; break;\r\n\t\t\t\t\t\tcase \"5\" : state_html += \t\"<td>페널티구역</td>\"; break;\r\n\t\t\t\t\t\tcase \"6\" : state_html += \t\"<td>벙커</td>\"; break;\r\n\t\t\t\t\t\tcase \"7\" : state_html += \t\"<td>분실구</td>\"; break;\r\n\t\t\t\t\t\tcase \"8\" : state_html += \t\"<td>벌타</td>\"; break;\r\n\t\t\t\t\t\tcase \"9\" : state_html += \t\"<td>그린주변벙커</td>\"; break;\r\n\t\t\t\t\t\tcase \"10\" : state_html += \t\"<td>홀인</td>\"; break;\r\n\t\t\t\t\t\tcase \"12\" : state_html += \t\"<td>프린지</td>\"; break;\r\n\t\t\t\t\t}\r\n\t\t\t\t\tif(v.pp_state == \"10\"){\r\n\t\t\t\t\t\tvar scoreText = shotTrackerScoreText(shotTrackerList.length, holeInfo.stdScore);\r\n\t\t\t\t\t\tstate_html += \t\"<td colspan='\"+(map3dResourceYN == \"Y\" ? '2':'1')+\"'><button class='btn btn-sm btn-outline-gray rounded-pill w-100' style='cursor: default; font-weight: bold; color:#212529;' >\"+scoreText+\"</button></td>\";\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t} else {\r\n\t\t\t\t\t\tstate_html += \t\"<td>\"+v.pp_distance+\"</td>\";\r\n\t\t\t\t\t\tif(map3dResourceYN == \"Y\") {\r\n\t\t\t\t\t\t\tstate_html += \t\"<td>\";\r\n\t\t\t\t\t\t\tif(v.pp_altitude !== undefined && v.pp_altitude != \"999.0\" && v.pp_state != \"10\" && v.pp_state != \"7\" ){\r\n\t\t\t\t\t\t\t\tstate_html += \t\"<span class='\"+(v.pp_altitude == 0 ? '': (v.pp_altitude > 0 ? 'text-red' : 'text-blue'))+\"'>\"+(v.pp_altitude > 0 ? '+':'')+v.pp_altitude+\"</span>\";\t\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\tstate_html += \t\"</td>\";\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n\t\t\t\t\tstate_html += \"</tr>\";\r\n\r\n\t\t\t\t}\r\n\t\t\t\thole_html += \"</g>\";\r\n\t\t\t\tgreen_html += \"</g>\";\r\n\t\t\t}\r\n\t\t\t\r\n\t\t\t// 거리\r\n\t\t\tfor(var i=0; i<extraPlayerList.length; i++){\r\n\t\t\t\tvar shotTrackerList = extraShotTrackerList[i];\r\n\t\t\t\thole_html +=  \"<g class='player\"+(i+1)+\"'>\";\r\n\t\t\t\t\r\n\t\t\t\t// 거리\r\n\t\t\t\tfor(var j = 0; j < shotTrackerList.length; j++){\r\n\t\t\t\t\tvar v = shotTrackerList[j];\r\n\t\t\t\t\tvar x = (390-(v.pp_y*2))*1.815;\r\n\t\t\t\t\tvar y = (v.pp_x*2)*1.815;\r\n\t\t\t\t\tvar x_g = (390-(v.pp_greeny*2))*1.815;\r\n\t\t\t\t\tvar y_g = (v.pp_greenx*2)*1.815;\r\n\t\t\t\t\t\r\n\t\t\t\t\tif(j==0){\r\n\t\t\t\t\t\tvar rectX = 0;\r\n\t\t\t\t\t\tvar rectY = 0;\r\n\t\t\t\t\t\tvar tmpX = (390-bi_sy)*1.815;\r\n\t\t\t\t\t\tvar tmpY = bi_sx*1.815;\r\n\t\t\t\t\t\tif((i+1)==1){\r\n\t\t\t\t\t\t\trectX = (3*tmpX + x)/4-25;\r\n\t\t\t\t\t\t\trectY = (3*tmpY + y)/4-13;\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t\telse if((i+1)==2){\r\n\t\t\t\t\t\t\trectX = (tmpX + x)/2-25;\r\n\t\t\t\t\t\t\trectY = (tmpY + y)/2-13;\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t\telse if((i+1)==3){\r\n\t\t\t\t\t\t\trectX = (tmpX + 3*x)/4-25;\r\n\t\t\t\t\t\t\trectY = (tmpY + 3*y)/4-13;\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t\tif((v.pp_state!=\"4\" && v.pp_state!=\"7\" && v.pp_state!=\"8\") && !(v.pp_state==\"5\" && shotTrackerList[j+1].pp_state==\"8\")){\r\n\t\t\t\t\t\t\thole_html += '<rect x=\"'+rectX+'\" y=\"'+rectY+'\" width=\"50\" height=\"25\" rx=\"10\" fill=\"#ffffff\" stroke-width=\"2\"></rect>';\r\n\t\t\t\t\t\t\thole_html += '<text text-anchor=\"middle\" x=\"'+rectX+'\" y=\"'+rectY+'\" dx=\"24\" dy=\"19\" font-weight=\"600\" font-size=\"18\">'+v.pp_distanceLen+'</text>';\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n\r\n\t\t\t\t}\r\n\t\t\t\thole_html += \"</g>\";\r\n\t\t\t}\r\n\t\t\t\r\n\t\t\t// 홀컵위치\r\n\t\t\tgreen_html += \"<image href='/resources/web/images/holeCup.png' x='\"+(390-bi_gy-4)*1.815+\"' y='\"+(bi_gx-30)*1.815+\"' />\";\r\n\t\t\t\r\n\t\t\thole_html += \"</svg>\";\r\n\t\t\tgreen_html += \"</svg>\";\r\n\t\t\t\r\n\t\t\thole_html += '<div class=\"map-hole-img\"><img src=\"https://klpga.co.kr/DATA/holeImg2/2026060002/'+holeInfo.hole+'.png?ver=\" style=\"width:100%;\"></div>';\r\n\t\t\tgreen_html += '<div class=\"map-green-img\"><img src=\"https://klpga.co.kr/DATA/holeImg2/2026060002/'+holeInfo.hole+'_G.png?ver=\" style=\"width:100%;\"></div>';\r\n\t\t\t\r\n\t\t\t$(\"#divShotTracker_hole_extra\").html(hole_html);\r\n\t\t\t\r\n\t\t\t$(\"#divShotTracker_green_extra\").html(green_html);\r\n\t\t\t$(\"[id=tbodyShotStateExtra]\").html(state_html);\r\n\t\t\t\r\n\t\t\t\r\n\t\t\t\r\n\t\t}\r\n\t\t, error:function(request,status,error){\r\n\t    }\r\n\t});\r\n\t\r\n\t\r\n}\r\n\r\n\r\nfunction shotTrackerScoreText(strokeScore, stdScore){\r\n\t\r\n\tvar result = \"\";\r\n\t\r\n\tvar score = strokeScore-stdScore;\r\n\tif(stdScore == \"5\" && score == -3){\r\n\t\tresult = \"알바트로스\";\r\n\t} else if(strokeScore == 1){\r\n\t\tresult = \"홀인원\";\r\n\t} else if(score == -2){\r\n\t\tresult = \"이글\";\r\n\t} else if(score == -1){\r\n\t\tresult = \"버디\";\r\n\t} else if(score == 0){\r\n\t\tresult = \"파\";\r\n\t} else if(score == 1){\r\n\t\tresult = \"보기\";\r\n\t} else if(score == 2){\r\n\t\tresult = \"더블 보기\";\r\n\t} else if(score == 3){\r\n\t\tresult = \"트리플 보기\";\r\n\t} else if(score == 4){\r\n\t\tresult = \"쿼드러플 보기\";\r\n\t} else if(score == 5){\r\n\t\tresult = \"퀸튜플 보기\";\r\n\t} else if(score == 6){\r\n\t\tresult = \"섹스터플 보기\";\r\n\t} else if(score == 7){\r\n\t\tresult = \"셉터플 보기\";\r\n\t} else if(score == 8){\r\n\t\tresult = \"옥튜플 보기\";\r\n\t}\r\n\t\r\n\treturn result;\r\n}\r\n\r\n\r\n\r\n</script>\r\n\r\n\r\n<!--------------------------------------------------------------------------------------------------------------------------->\r\n<!-------------------------------------------- 리더보드 컨텐츠 : FULL LEADERBOARD -------------------------------------------->\r\n<!--------------------------------------------------------------------------------------------------------------------------->  